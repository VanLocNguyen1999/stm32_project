  59:board/stm32f401rct6/Core/Extension/lcd.c **** 	char str[5];
  60:board/stm32f401rct6/Core/Extension/lcd.c **** 	sprintf(str, "%d", number); // chuyển từ số sang chuỗi
  61:board/stm32f401rct6/Core/Extension/lcd.c **** 	lcd_puts(str);
  62:board/stm32f401rct6/Core/Extension/lcd.c **** }
