  36:board/stm32f401rct6/Core/Extension/lcd.c **** 
  37:board/stm32f401rct6/Core/Extension/lcd.c **** void lcd_gotoxy(char x, char y)
  38:board/stm32f401rct6/Core/Extension/lcd.c **** {
  39:board/stm32f401rct6/Core/Extension/lcd.c **** 	char addr = 0;
  40:board/stm32f401rct6/Core/Extension/lcd.c **** 	if (y == 0)
  41:board/stm32f401rct6/Core/Extension/lcd.c **** 		addr =0x80 + x;
  42:board/stm32f401rct6/Core/Extension/lcd.c **** 
  43:board/stm32f401rct6/Core/Extension/lcd.c **** 	if (y == 1)
  44:board/stm32f401rct6/Core/Extension/lcd.c **** 		addr =0xC0 + x;
  45:board/stm32f401rct6/Core/Extension/lcd.c **** 
  46:board/stm32f401rct6/Core/Extension/lcd.c **** 	lcd_command(addr);
  47:board/stm32f401rct6/Core/Extension/lcd.c **** }
  48:board/stm32f401rct6/Core/Extension/lcd.c **** 
  49:board/stm32f401rct6/Core/Extension/lcd.c **** void lcd_puts(char *s) // gửi 1 chỗi kí tự
  50:board/stm32f401rct6/Core/Extension/lcd.c **** {
  51:board/stm32f401rct6/Core/Extension/lcd.c ****    	while (*s)
  52:board/stm32f401rct6/Core/Extension/lcd.c **** 		{
  53:board/stm32f401rct6/Core/Extension/lcd.c ****       lcd_putchar(*s);
  54:board/stm32f401rct6/Core/Extension/lcd.c ****      	s++;
  55:board/stm32f401rct6/Core/Extension/lcd.c ****    	}
  56:board/stm32f401rct6/Core/Extension/lcd.c **** }
