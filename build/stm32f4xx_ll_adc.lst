2638:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   * @brief  Set ADC group regular conversion data transfer: no transfer or
2639:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         transfer by DMA, and DMA requests mode.
2640:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   * @note   If transfer by DMA selected, specifies the DMA requests
2641:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         mode:
2642:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         - Limited mode (One shot mode): DMA transfer requests are stopped
2643:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *           when number of DMA data transfers (number of
2644:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *           ADC conversions) is reached.
2645:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *           This ADC mode is intended to be used with DMA mode non-circular.
2646:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         - Unlimited mode: DMA transfer requests are unlimited,
2647:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *           whatever number of DMA data transfers (number of
2648:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *           ADC conversions).
2649:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *           This ADC mode is intended to be used with DMA mode circular.
2650:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   * @note   If ADC DMA requests mode is set to unlimited and DMA is set to
2651:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         mode non-circular:
2652:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         when DMA transfers size will be reached, DMA will stop transfers of
2653:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         ADC conversions data ADC will raise an overrun error
2654:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *        (overrun flag and interruption if enabled).
2655:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   * @note   For devices with several ADC instances: ADC multimode DMA
2656:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         settings are available using function @ref LL_ADC_SetMultiDMATransfer().
2657:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   * @note   To configure DMA source address (peripheral address),
2658:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         use function @ref LL_ADC_DMA_GetRegAddr().
2659:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   * @rmtoll CR2      DMA            LL_ADC_REG_SetDMATransfer\n
2660:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         CR2      DDS            LL_ADC_REG_SetDMATransfer
2661:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   * @param  ADCx ADC instance
2662:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   * @param  DMATransfer This parameter can be one of the following values:
2663:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         @arg @ref LL_ADC_REG_DMA_TRANSFER_NONE
2664:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         @arg @ref LL_ADC_REG_DMA_TRANSFER_LIMITED
2665:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   *         @arg @ref LL_ADC_REG_DMA_TRANSFER_UNLIMITED
2666:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   * @retval None
2667:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h ****   */
2668:board/stm32f401rct6/Drivers/STM32F4xx_HAL_Driver/Inc/stm32f4xx_ll_adc.h **** __STATIC_INLINE void LL_ADC_REG_SetDMATransfer(ADC_TypeDef *ADCx, uint32_t DMATransfer)
